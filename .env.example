# ============================================
# SentinelAI Environment Configuration
# ============================================

# Application
SENTINEL_ENV=development
SENTINEL_DEBUG=false
SENTINEL_LOG_LEVEL=INFO

# API - used in later phases
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000

# LLM - used in later phases
SENTINEL_LLM_PROVIDER=ollama
SENTINEL_LLM_MODEL=qwen3:8b

# Never place real passwords, tokens,
# API keys, or credentials in this file.